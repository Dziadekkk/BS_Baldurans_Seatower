@1 = ~Balduran's Seatower mod do BG I EE i EET~
@2 = ~Instalujesz na nieodpowiedniej grze.~
@3 = ~Ta modyfikacja winna byc instalowana PRZED instalacja Worldmap.~
@4 = ~Uaktualnianie Worldmap...~
@5 = ~Ta modyfikacja winna byc instalowana przed EET_End twojej instalacji EET.~

//******************
// Mapnotes and info points
//******************
@20 = ~Świątynia Selune~
@21 = ~Koszary~
@22 = ~Płatnerz~
@23 = ~Łuczniczka~
@24 = ~Wieża Morska Baldurana~
@25 = ~Nizioproca~
@26 = ~Lista dzisiejszych wart. Śmiertelne nudy.~
@27 = ~Monumentalny posąg Baldurana. Przypomina bardziej dwuipółmetrowego ogra, który lada moment ma się przewrócić.~
@28 = ~Napis głosi: „Balduran”. W niczym nie przypomina on jednak żadnego z portretów założyciela miasta, jakie kiedykolwiek dane ci było oglądać.~
@29 = ~Stosy kamieni przygotowane do użycia w trebuszach na dachu.~
@30 = ~Właz jest zamknięty.~
@31 = ~Świątynia Ilmatera~
@32 = ~Czytasz stronę. Widnieje na niej: „Jestem wszystkimi barwami i żadną zarazem”.~
@33 = ~Garbarnia~
@34 = ~Katakumby~
@35 = ~Gospoda w Wieży~
@36 = ~Wieża Smoka~
@37 = ~Napitki Złotego Smoka~
@38 = ~Najlepsze szaty Maestra~
@39 = ~Skarbiec~
@40 = ~Wieża Chionthar~
@41 = ~Wieża Zdrajcy~
@42 = ~Wieża Łańcuchowa~
@43 = ~Wieża Dradeela~
@44 = ~Wieża Południowego Portu~
@45 = ~Wieża Portowa~
@46 = ~Wieża Wschodnia~
@47 = ~Kryjówka handlarzy niewolników~
@48 = ~Magiczne przedmioty mistrza Shizella~
@49 = ~Słynny – i ZAMKNIĘTY – skład z trunkami.~
@50 = ~Studnia Wieży~
@51 = ~Latarnia Wieży~
@52 = ~Podczas badania książki znajdujesz osmoloną soczewkę ukrytą w jej grzbiecie.~
@53 = ~To nie jest głos, który możesz usłyszeć, a jednak słowa są jasne: „Ta książka otwiera się tylko dla <PRO_HESHE>, który/a otrzymał/a zwój”.~
@54 = ~To jest grobowiec patrycjuszowskiej rodziny Shattershield.~
@55 = ~To jest grobowiec patrycjuszowskiej rodziny Guthmere.~
@56 = ~Wejście do więzienia~
@57 = ~Widzisz tam w dole ciężkie drzwi. Wygląda na to, że to wejście do więzienia Seatower.~
@58 = ~Posąg humanoidalnej postaci. Wygląda na starożytny, a kamień jest tak zwietrzały, że nie radzisz sobie z określeniem, co ma przedstawiać.~
@59 = ~Te drzwi portalowe są nieaktywne i nigdzie nie prowadzą.~
@60 = ~Wystawa stworzeń morskich, nieruchomych, jakby zamrożonych. Co dziwne, nie wydaje się tu szczególnie zimno.~
@61 = ~Wystawa mniejszych rekinów.~
@62 = ~Widzisz ogromną ośmiornicę.~
@63 = ~Jest tu kilka żółwi.~
@64 = ~Nie możesz dostrzec, co jest w środku, szyba jest mętna.~
@65 = ~Widzisz kilka węgorzy lub ryb przypominających węgorze.~
@66 = ~Ta gablota jest pusta.~
@67 = ~Są tutaj mieczniki.~
@68 = ~Kaplica~
@69 = ~Te drzwi są magicznie zapieczętowane. Ktoś wydrapał na nich strzałkę wskazującą w lewo.~
@70 = ~Wielka, głęboka dziura w ziemi. Sięga głębiej, niż sięga Twój wzrok, i zdecydowanie głębiej, niż chcesz spaść.~
@71 = ~Ściana jest wybrukowana czaszkami o różnych kształtach i rozmiarach, ale większość z nich należy do humanoidów. Wyglądają na starożytne, to prawdopodobnie pozostałości po bóstwie, które czczono w tym miejscu. Kości na podłodze wyglądają na dość świeże. Podejrzewasz, że zostały tu porzucone przez sahuaginów.~
@72 = ~W tej gablocie znajduje się jakieś ogromne *coś*. Nie potrafisz dostrzec całego jego konturu i jasne jest, że widoczna jest tylko część stworzenia. Cieszysz się, że nie spotkasz go pod wodą i że jest martwe lub przynajmniej w jakiś sposób zamrożone w czasie.~
@73 = ~Ten statek wygląda bardziej jak skif. Widzisz uszkodzenia jego kadłuba. Piraci rozpoczęli już naprawy, ale minie sporo czasu, zanim będzie mogła postawić żagle.~
@74 = ~Wydaje się, że to było główne wejście do Starej Świątyni. Widzisz wiele skrzydlatych postaci. Jakiekolwiek bóstwo tu czczono, jeśli jego domeną było powietrze i lot, tłumaczyłoby to, dlaczego jego wyznawcy nie mieli problemu z wybudowaniem świątyni na tak odległej wyspie.~
@75 = ~Beczka z jabłkami.~
@76 = ~Ukryta skrytka bandytów~
@77 = ~Miejsce spotkań przemytników~

