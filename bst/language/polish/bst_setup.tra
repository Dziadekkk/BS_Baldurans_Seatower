//******************
//Items
//******************
@500 = ~Klucz do spiżarni~
@501 = ~Klucz do spiżarni w Wieży Morskiej Baldurana.~
@502 = ~Gęsie pióra~
@503 = ~Worek gęsich piór, który wręczyła ci czeladniczka kuchenna. Mają trafić do łuczniczki w Wieży, by posłużyć jako materiał na lotki strzał.~
@504 = ~Kufel dla Nizioprocy~
@505 = ~Kufel Napitku Złotego Smoka uwarzonego przez kucharkę z Wieży Morskiej Baldurana. Lepiej nie wspominać, ile cię to kosztowało.~
@506 = ~Fałszywa Zguba smoków Arli~
@507 = ~Bardzo nieudolna kopia słynnej procy zwanej Zgubą smoków Arli. Biorąc pod uwagę trudy, jakie trzeba było znieść, by ją zdobyć, wysiłek okazał się niewart zachodu: ta nędzna imitacja jest zaledwie odrobinę lepsza od zwykłego kawałka skóry i drewna.

PARAMETRY:

Obrażenia: +1
TraK0: +1
Typ obrażeń: pocisk
Opóźnienie: 3
Rodzaj biegłości: proca
Typ broni: 1-ręczna

Wymagania:
– Siła: 3

Waga: 1~
@508 = ~Przepustka do więzienia Wieży~
@509 = ~Ta przepustka zapewnia dostęp do więzienia w Wieży Morskiej Baldurana. Wejście do lochów znajduje się w głównej wieży i prowadzi schodami w dół.~
@510 = ~Zwój Almirana~
@511 = ~Ten zwój ma rzekomo otwierać ukryte przejście prowadzące do ruin w Lesie Ostrych Kłów.~
@512 = ~Klucz Alguine'a~
@513 = ~Klucz Alguine'a otwiera zamknięte drzwi w Salach Wspomnień Przyszłości.~
@514 = ~Klucz do katakumb~
@515 = ~Klucz ten otwiera ukryte drzwi w mauzoleum pod Wieżą Morską Baldurana.~
@516 = ~Klucz do Wieży Chionthar~
@517 = ~Klucz do mauzoleum w Wieży Chionthar. Katakumby Wieży Morskiej Baldurana rozciągają się pod jej fundamentami.~
@518 = ~Kościany sztylet ogra~
@519 = ~Głownia tego sztyletu została wykonana z kości dawno padłego i zapomnianego potwora. Ostrze wciąż jest tak ostre, jak w dniu, w którym zostało wyrzeźbione. Nadal też ciąży na nim klątwa.~
@520 = ~Czaszka kobiety~
@521 = ~Ta poczerniała i zwęglona czaszka przetrwała pożar, który powinien był obrócić ją w popiół.~
@522 = ~Świeca czarownika~
@523 = ~Świeca ta zawiera jeden ładunek czaru Życzenie. Zabierając ją, odmówiłeś czarownikowi spełnienia jego ostatniej prośby.~ ~Świeca ta zawiera jeden ładunek czaru Życzenie. Zabierając ją, odmówiłaś czarownikowi spełnienia jego ostatniej prośby.~
@524 = ~Szpon wojownika~
@525 = ~Istota, do której należał ten wysuszony szpon, z pewnością nie pochodziła z tej Sfery egzystencji.~
@526 = ~Antidotum zatrutego mężczyzny~
@527 = ~Gęsty, czerwony płyn groźnie kotłuje się w butelce. Zabierając go, odebrałeś zatrutemu mężczyźnie ostatnią szansę na przeżycie.~ ~Gęsty, czerwony płyn groźnie kotłuje się w butelce. Zabierając go, odebrałaś zatrutemu mężczyźnie ostatnią szansę na przeżycie.~
@528 = ~Przyglądasz się trawie i widzisz, że ktoś niedawno wykopał i zasypał tu niewielki dół. Po dokładnym zbadaniu miejsca znajdujesz szczątki młodego mnicha pogrzebane ledwie kilka centymetrów pod ziemią.~
@529 = ~Księga Sfer~
@530 = ~Księga ta spoczywała w zapomnianym kącie biblioteki Alguine'a. Próbujesz zgłębić jej treść, lecz im więcej stron przewracasz, tym mniej ma to wszystko sens. Znaczna część tekstu najwyraźniej... wyparowała... a reszta wygląda na bazgroły dziecka. Co gorsza, za każdym razem, gdy ją otwierasz, układ stron zdaje się zupełnie inny.~
@531 = ~Rysunek Larsa~
@532  = ~Rysunek, który wręczył ci Lars, osierocony chłopiec. Malunek nieco przypomina coś, co MOGŁOBY być smokiem. Nie masz pojęcia, do czego mógłby ci się przydać, ale jeśli go wyrzucisz, mały autor z pewnością będzie smutny, a gdzieś na świecie umrze niewinny kociak.~
@533  = ~Królicza klatka~
@534  = ~Klatka, którą wręczył ci karczmarz Roryn, do zebrania królików z trzeciego piętra Gospody w Wieży Morskiej Baldurana.~
@535  = ~Szczurzyca Betsy~
@536  = ~Złapana przez ciebie na pierwszym piętrze Gospody w Wieży Morskiej Baldurana szczurzyca. Jest wyjątkowo utuczona, a na ogonie ma maleńką różową kokardkę z misternie wypisanym imieniem „Betsy”. Gryzoń przygląda ci się uważnie, ale nie wygląda, jakby zamierzał cię ugryźć.~
@537  = ~Truchło szczurzycy, którą zabiłeś na pierwszym piętrze Gospody w Wieży Morskiej Baldurana szczurzyca. Na jej ogonie wciąż widać maleńką różową kokardkę, na której ktoś starannie napisał słowo „Betsy”.~
@538  = ~Ulotka handlarzy niewolników~
@539  = ~Zdobyte od przemytników dane kontaktowe handlarzy niewolników. Ulotka udaje ogłoszenie o „wyprawach za dziką zwierzyną” organizowanych przez „Leonharda Zawziętego”, którego można spotkać na trzecim piętrze Gospody w Wieży Morskiej Baldurana. Na odwrocie widnieje odręczna notatka: „pytać o zwierzynę specjalną”.~
@540  = ~Zapieczętowana szkatułka~
@541  = ~Szkatułka jest lekka, a gdy nią potrząsasz, w środku nic nie grzechocze.~
@542  = ~Notatki handlarzy niewolników~
@543  = ~To notatki znalezione przy ciele „Leonharda Zawziętego”, pośrednika handlarzy niewolników. Zawierają harmonogram różnych niewinnie brzmiących „wypraw”. Jedna z nich, zaplanowana na przyszłość, nosi intrygującą nazwę: „Pościg za zwierzyną specjalną”.~
//#73906 (BGII)
@544  = ~[#73906 (BGII)]Pierścień przeciw jadowi~
//#73913 (BGII)
@545  = ~[#73913 (BGII)]Ten srebrny pierścień pozbawiony jest jakichkolwiek ozdób, jednak mimo prostego wyglądu stanowi źródło potężnej magii. Pierścień przeciw jadowi jest bardzo ceniony przez członków rodzin królewskich, wpływowych polityków i inne osoby mogące stać się celem zabójców.

PARAMETRY:

Specjalne:
– Niewrażliwość na trucizny~
@546  = ~Czarna perła w muszli~
@547  = ~Perły powstają, gdy ostryga lub inny mięczak otacza ziarenko piasku bądź inny drażniący obiekt kolejnymi warstwami aragonitu, tworząc strukturę o głębokim połysku. Większość pereł w Faerunie jest biała, lecz istnieją rzadsze odmiany, takie jak tęczowe czy czarne. Ta czarna perła jest wysoko ceniona ze względu na wyjątkowe właściwości magiczne. Została świeżo wyjęta z muszli i wciąż połyskuje morską wodą.~
@548  = ~Klucz krawca~
@549  = ~Klucz ten otwiera zamknięte drzwi w zakładzie krawieckim w Dzielnicy Doków.~
@550  = ~Pył mimika~
@551  = ~To właśnie mistrz Shizell nazwał „Pyłem mimika”. W rzeczywistości jest to płyn, który skutecznie demaskuje sobowtórniaki.

Fiolkę należy jak najszybciej spożytkować, nim jej efektywność zaniknie. Nie została ona bowiem szczelnie zamknięta i widać wydobywające się z niej niewielkie smużki oparów, które, lubo nieszkodliwe, wchodzą w reakcję z naturalną wonią panującą w Wieży Morskiej Baldurana i jej otoczeniu. Powstały w ten sposób zapach doprowadza sobowtórniaki do szewskiej pasji, zmuszając je do odrzucenia przybranej postaci, ujawnienia swej prawdziwej, szpetnej formy i natychmiastowego ataku.~
@552  = ~Likier ziołowy~
@553  = ~Zakurzona butelka ziołowego likieru z odległej destylarni. Wygląda to na trunek, który najlepiej trzymać w bezpiecznym miejscu, póki nie napotkasz odpowiedniego konesera.~
@554  = ~Pusta fiolka po Pyle mimika~
@555  = ~Fiolka została całkowicie opróżniona. Substancja nie działa już na sobowtórniaki.~
@556  = ~Weksel skarbowy~
@557  = ~Weksel ten uprawnia okaziciela do odbioru 3000 sztuk złota ze Skarbca Wieży Morskiej.~
@558  = ~Weksel ten uprawnia okaziciela do odbioru 5000 sztuk złota ze Skarbca Wieży Morskiej.~
@559  = ~Weksel ten uprawnia okaziciela do odbioru 20 000 sztuk złota ze Skarbca Wieży Morskiej.~
@560  = ~Likier śliwkowy~
@561  = ~Wykwintna butelka calimshańskiego likieru śliwkowego. Wygląda to na trunek, który najlepiej trzymać w bezpiecznym miejscu, póki nie napotkasz odpowiedniego konesera.~
@562  = ~Gorzki likier~
@563  = ~Wykwintna butelka amnijskiego gorzkiego likieru. Wygląda to na trunek, który najlepiej trzymać w bezpiecznym miejscu, póki nie napotkasz odpowiedniego konesera.~
@564  = ~Weksel ten uprawnia okaziciela do odbioru 500 sztuk złota ze Skarbca Wieży Morskiej.~
@565  = ~Pusta beczka~
@566  = ~Zwykła, pusta beczka.~
@567  = ~Beczka pełna wody~
@568  = ~Beczka wypełniona wodą~
@569  = ~Ognioodporna beczka~
@570  = ~Kowal z Wieży pokrył wnętrze tej beczki ognioodporną warstwą. Powinna ona wytrzymać żar żywiołaka ognia przez co najmniej jeden dzień.~
@571  = ~Beczka z żywiołakiem ognia~
@572  = ~W tej beczce zamknięty jest żywiołak ognia ze spiżarni. Pojemnik jest lekko nagrzany, a od czasu do czasu dobiega z niego ciche trzaskanie, jakby tlił się w nim płomień.~
@573 = ~Twój Złoty Smok~
@574 = ~Kufel Napitku Złotego Smoka uwarzonego przez kucharkę w Wieży Morskiej Baldurana. Zdobycie go było nieco kłopotliwe, lecz został nalany z jak najlepszymi intencjami.

PARAMETRY:

Właściwości ładunku:
– Zręczność: -2
– Chroni przed strachem
Czas działania: 15 tur

Waga: 1~
@575  = ~Gruczoł łojowy trolla morskiego~
@576 = ~Gruczoł łojowy uzyskany z truchła trolla morskiego. Nieustannie wydziela galaretowatą substancję, która – jak mówią – wyjątkowo dobrze chroni metal przed niszczącym działaniem wody.~
@577 = ~Soczewka skupiająca~
@578 = ~Jest to soczewka używana do skupiania promieni światła.~
@579 = ~Czarna soczewka~
@580 = ~Ten kryształ jest okrągły jak soczewka, ale całkowicie czarny i nieprzezroczysty.~
@581 = ~Almanach o trollach~
@582 = ~[BG:EE #32739]Trolle to potworne drapieżniki, które są najbardziej znane z tego, że trudno je zabić. Wszystkie trolle regenerują się, a większość z nich można zgładzić jedynie przy użyciu ognia.~
@583 = ~Flisza z wodą~
@584 = ~To jest flasza z wodą zdatną do picia.~
@585 = ~Almanach o żywiołakach ognia~
@586 = ~Żywiołaki ognia przybywają ze Sfery Żywiołu Ognia, wykorzystując palące płomienie jako portale do przemierzania wymiarów. Pozbawione ognia, który podtrzymuje ich siły życiowe, szybko słabną. Dlatego nieustannie szukają ognistych pożarów, które służą im jako przejścia do ich rodzinnego wymiaru.~
@589 = ~Księga przyszłych wspomnień~
@590 = ~Dziennik lorda Dluskera~
@591 = ~To wydają się być osobiste notatki lorda Dluskera. Opowiadają o finansowych kłopotach rodziny i coraz bardziej rozpaczliwych próbach lorda, by je przezwyciężyć.
Ostatnia strona głosi:
„Mam teraz środki, by osobiście zapytać Aldaberta II o ukryty skarb! Pomyśleć, że kapłani żądali 1000 sztuk złota za jedno Rozmawianie ze Zmarłymi, podczas gdy ja zdobyłem Tymczasowe Wskrzeszenie za zaledwie 200!
Nie mogę się doczekać, by zobaczyć minę Margot, gdy będę mógł powiedzieć jej o skrzyni ze skarbami w naszym domu! Na razie jej nie powiem, bo za bardzo bałaby się, że odprawiam taki rytuał.
Mnisi zapewniali nas, że mauzoleum jest bezpieczne, pomimo zwiększonej aktywności nieumarłych w katakumbach. I tak nie planowałem tam iść, więc nie widzę problemu. Ponadto mam magiczny naszyjnik mojego dziadka, który ochroni mnie przed wszelkimi nieudanymi zaklę Liam.
Ostrzeżenie mnichów będzie idealną wymówką, by Margot zaczekała na zewnątrz, dzięki czemu nie będzie się martwić (i, z ręką na sercu, powstrzyma ją to również przed wtrącaniem się).”~
@592 = ~Zwój z symbolem Myrkula~
@593 = ~To jest zwój pokryty kilkoma symbolami.
Choć nie jesteś w stanie go odczytać, zwój wydaje się być gotowy do użycia przez każdego, kto trzyma go w dłoni.~
@594 = ~Martwy szczur~
@595 = ~To jest martwy szczur. Wygląda na zaskakująco nienaruszonego i został umieszczony tak, abyś *musiał* go znaleźć.~
@596 = ~Pierścień sił życiowych~
@597 = ~Ten pierścień nie wygląda na nic szczególnego, ale jest wyraźnie zaklęty magią. Posiada finezyjny grawerunek o treści: „Dla A. w miłości”. Znalazłeś ten pierścień przy jednych ze zwłok pod zakładem krawieckim.~
@598 = ~Ten pierścień nie wygląda na nic szczególnego, ale posiada finezyjny grawerunek o treści: „Dla A. w miłości”. Znalazłeś go przy jednych ze zwłok pod zakładem krawieckim.

PARAMETRY:
  +4 do maksymalnej liczby PŻ podczas noszenia
~
@599 = ~Pierścień odporności na kwas~
@600 = ~Ten pierścień został kunsztownie wykonany z zielonego metalu i ozdobiony cennym klejnotem. Znalazłeś go przy jednych ze zwłok pod zakładem krawieckim.~
@601 = ~Ten pierścień został kunsztownie wykonany z zielonego metalu i ozdobiony cennym klejnotem. Znalazłeś go przy jednych ze zwłok pod zakładem krawieckim.

PARAMETRY:
  Odporność na kwas: 100%
~
@602 = ~Pierścień biegłości w walce bronią~
@603 = ~Choć może się to wydawać niezwykłe, że pierścień został zaklęty właściwością poprawiającą umiejętności władania bronią, idealnie wpisuje się to w otoczenie szlachetnie urodzonych dam i lordów, którzy nie chcą paradować w ciężkich pancerzach, a jednak mają powód, by zwiększyć swoje zdolności obronne – i to w taki sposób, by potencjalni napastnicy nawet nie byli tego świadomi.

PARAMETRY:

TraKO:  +1
~
@604 = ~Pierścień Wdzięczności <CHARNAME>~
@605 = ~Ten pierścień wygląda jak zwykła złota obrączka, ale bez wątpienia spowija go potężna magia. Widnieje na nim grawerunek o treści: „Dla <CHARNAME>, w dowód wdzięczności”. Otrzymałeś go jako spóźniony wyraz uznania od kilku wdzięcznych rodzin patrycjuszy z Wrót Baldura za pomoc w walce z inwazją doppelgangerów.~
@606 = ~Ten pierścień wygląda jak zwykła złota obrączka, ale bez wątpienia spowija go potężna magia. Widnieje na nim grawerunek o treści: „Dla <CHARNAME>, w dowód wdzięczności”. Otrzymałeś go jako spóźniony wyraz uznania od kilku wdzięcznych rodzin patrycjuszy z Wrót Baldura za pomoc w walce z inwazją doppelgangerów.

PARAMETRY:

Zdolności wyposażenia:
 Zwiększa charyzmę użytkownika do 18
 Właściciel regeneruje 1 punkt życia co 30 sekund
~
@607 = ~Ten pierścień wygląda jak zwykła złota obrączka, ale bez wątpienia spowija go potężna magia. Widnieje na nim grawerunek o treści: „Dla <CHARNAME>, w dowód wdzięczności”. Otrzymałeś go jako spóźniony wyraz uznania od kilku wdzięcznych rodzin patrycjuszy z Wrót Baldura za pomoc w walce z inwazją doppelgangerów.

PARAMETRY:

Zdolności wyposażenia:
 Charyzma:  premia +1
 Właściciel regeneruje 1 punkt życia co 30 sekund
~
@608 = ~List od Ivonne~
@609 = ~List od Balduina~
@610 = ~To list miłosny od osoby imieniem Ivonne do kogoś o imieniu Balduin. Pachnie różami.~
@611 = ~To list miłosny od Balduina do Ivonne. Jest podpisany dwoma przeplatającymi się sercami.~
@612 = ~To kolejny list miłosny od Ivonne do Balduina. Dziękuje mu w nim wylewnie za piękny rysunek.~
@613 = ~Drogi nieznany czytelniku,

Zauważyliśmy, że ktoś czytał naszą ukrytą korespondencję. Przenieśliśmy nasze sekretne miejsce gdzie indziej.

Niemniej jednak składamy Ci szczere podziękowania za to, że nie zakłóciłeś naszej komunikacji. Przyjmij to jako dowód naszej wdzięczności.

Balduin i Ivonne~
@614 = ~Ząb Iakhovasa~
@615 = ~Ta relikwia to ząb Iakhovasa, dawnego kochanka Umberlee. Został przywieziony przez Baldurana z jego morskich podróży. Plotka głosi, że wszedł w jego posiadanie, gdy jego statek został zaatakowany przez sahuaginów.
Podarował go Świątyni Umberlee, aby zyskać przychylność bogini dla swoich dalszych przedsięwzięć oraz nowo ufortyfikowanego miasta Wrota Baldura.
Ząb ten jest dla świątyni rzeczą świętą.~
@616 = ~Opaska Charyzmy~
@617 = ~Ta wysadzana klejnotami opaska już sama w sobie przyciągałaby mnóstwo uwagi, ale spoczywa na niej subtelne zaklęcie, które sprawia, że postronni postrzegają noszącego w bardzo pozytywnym świetle – widząc w <PRO_HIMHER> wielkiego przywódcę lub godny zaufania autorytet.

PARAMETRY:

Charyzma: ustalona na 18~
@618 = ~Srebrna Rzutka Selûne~
@619 = ~Ta niewielka broń została pobłogosławiona przez Selûne, Naszą Panią ze Srebra. Dzięki temu posiada ona specjalne właściwości przeciwko likantropom oraz innym istotom wrażliwym wyłącznie na srebrną broń, na które wpływa czyste, srebrne światło księżyca.

PARAMETRY:

TraK0: premia +2 (premia +4 przeciwko likantropom)
Obrażenia: 1k3+2 (+4 przeciwko likantropom)
Typ obrażeń: pocisk (kłute)
Właściwości specjalne:
 Po rzuceniu wraca do rąk właściciela
Waga: 0
Opóźnienie: 1
Rodzaj biegłości: Rzutki
Typ: 1-ręczna
Nie może używać:
 Kapłan
 Mag~
@620 = ~Kamień Ioun: Srebrna Sfera~
@621 = ~Ta srebrzysta sfera posiada potężną moc odrzucania, która chroni użytkownika przed ciosami w plecy.

PARAMETRY:
 Niewrażliwość na ciosy w plecy podczas używania~
@622 = ~Długi łuk szybkości +2~
@623 = ~Ten zaklinany długi łuk potrafi wystrzelić morderczą salwę strzał. Nie ma on żadnej znanej nazwy ani historii; wydaje się być stosunkowo nowym przedmiotem, który nie miał jeszcze czasu zyskać prawdziwej sławy.

PARAMETRY:

TraK0: premia +3
Obrażenia: +2
Właściwości specjalne:
 1 dodatkowy atak na rundę
Waga: 3
Opóźnienie: 5
Rodzaj biegłości: Długi łuk
Typ: 2-ręczna
Wymagania: Siła 6
Nie może używać:
 Druid
 Kapłan
 Mag
 Złodziej~
@624 = ~Zbroja płytowa paladyna +2~
@619 = ~Ta niewielka broń została pobłogosławiona przez Selûne, Naszą Panią ze Srebra. Dzięki temu posiada ona specjalne właściwości przeciwko likantropom oraz innym istotom wrażliwym wyłącznie na srebrną broń, na które wpływa czyste, srebrne światło księżyca.

