@1000026 = ~Odkryj mapę Podmorskiej Wieży po wejściu na obszar~
@1000027 = ~Dostosuj walkę w pałacu pod kątem inwazji sobowtórów~
@1000028 = ~Umieść więcej żołnierzy Płomiennej Pięści w pałacu, jeśli inwazja została ujawniona~
@1000029 = ~Zmniejsz liczbę sobowtórów w pałacu, jeśli inwazja została ujawniona~
@1000030 = ~Umieść więcej sobowtórów w pałacu, jeśli inwazja nie została ujawniona~
@1000031 = ~Wykryto Baldur's Gate Trilogy.~
@1000032 = ~Wykryto BG:EE.~
@1000033 = ~Wykryto EET.~
@1000034 = ~Wykryto Jarl's Adventure Pack: „Priest of Oghma, Gond and Ilmater in Baldur's Gate”. Dodawanie kompatybilności (crossmod).~
