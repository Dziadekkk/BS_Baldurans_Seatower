@0  = ~Widzę, że już poczęstowałeś się przedmiotem, który miałem ci przekazać.~ ~Widzę, że już poczęstowałaś się przedmiotem, który miałem ci przekazać.~
@1  = ~Moje drzewo jest spragnione. Przynieś mi wodę. Wtedy dam ci to, czego potrzebujesz z tego miejsca.~
@2  = ~Przybywasz z darem dla mojego drzewa.~
@3  = ~Zgodnie z obietnicą, podaruję ci to, co mam w posiadaniu.~
@4  = ~Moja obecność tutaj nie jest już potrzebna.~
@5  = ~Odwiedziłeś tak wiele miejsc, aby zdobyć wodę dla mojego drzewa. Twoje wysiłki są doceniane.~ ~Odwiedziłaś tak wiele miejsc, aby zdobyć wodę dla mojego drzewa. Twoje wysiłki są doceniane.~
@6  = ~Co to za miejsce?~
@7  = ~Co masz na myśli mówiąc „to, czego potrzebuję z tego miejsca”?~
@8  = ~Gdzie znajdę tutaj wodę?~
@9  = ~A może po prostu wezmę to, co ukrywasz?~
@10 = ~Już pójdę.~
@11 = ~Służy to celowi, który zrozumiesz z czasem.~
@12 = ~Czy cokolwiek tutaj jest prawdziwe?~
@13 = ~Jest tak prawdziwe, jak to tylko konieczne.~
@14 = ~Przedmiot, którego potrzebujesz, aby móc przejrzeć na oczy.~
@15 = ~W drodze tutaj przemierzyłeś już kilka miejsc.~ ~W drodze tutaj przemierzyłaś już kilka miejsc.~
@16 = ~Co muszę tutaj znaleźć?~
@17 = ~Twoje czyny zostaną osądzone. Rób to, co podpowiada ci serce.~
@18 = ~Będę tutaj tak długo, jak będę potrzebny.~
